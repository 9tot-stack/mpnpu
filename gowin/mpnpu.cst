// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) physical constraints.
// Pin numbers cross-checked against Sipeed/Lushay Labs examples; verify against the board schematic.
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "rst_btn_n" 4;               // user button S1, active low
IO_PORT "rst_btn_n" PULL_MODE=UP;
IO_LOC "uart_tx" 17;                // FPGA TX -> BL702 USB-UART -> PC RX
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 18;                // PC TX -> BL702 -> FPGA RX
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
IO_LOC "led_n[0]" 10;  IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n[1]" 11;  IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n[2]" 13;  IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n[3]" 14;  IO_PORT "led_n[3]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n[4]" 15;  IO_PORT "led_n[4]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n[5]" 16;  IO_PORT "led_n[5]" PULL_MODE=UP DRIVE=8;
